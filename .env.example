# Copy to .env and fill in.

# --- Admin login (single-user demo)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Session signing key (must be long random in production)
SESSION_SECRET=please-change-me-to-a-long-random-string

# --- LLM (OpenAI-compatible, e.g. DeepSeek / OpenAI / Claude-via-gateway)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini

# --- Embedding (memU). Usually same provider as LLM, but cheaper/faster model
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-replace-me
EMBEDDING_MODEL=text-embedding-3-small

# --- Storage
DATA_DIR=./data
DB_PATH=./data/app.sqlite3
MEMU_DB_PATH=./data/memu.db

# --- App
APP_HOST=127.0.0.1
APP_PORT=8765
HISTORY_WINDOW=20
MAX_UPLOAD_MB=8